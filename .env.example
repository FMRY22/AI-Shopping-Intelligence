# See DEPLOYMENT.md §4 for the full secrets inventory and where each value is stored
# (Vercel env vars / GitHub Actions secrets) in real deployments.
# This file holds placeholders only -- never commit real values.

# --- Supabase (packages/database) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only / worker-only -- never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Next.js public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

